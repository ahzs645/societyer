{
  "$comment": "Entity copy sweep allow-list (tests/entity-copy-sweep.spec.ts). 'allow' = justified matches, each with a reason; an entry matches on pattern, optional route (exact, '*', or 'prefix*'), optional workspaces/channel, and 'snippet' (case-insensitive regex tested against the matched text snippet). 'knownLeaks' = baseline of real leaks ('workspace | route | pattern') tolerated until fixed; tighten by deleting entries (the report test lists entries that no longer reproduce). Never move a real leak into 'allow'.",
  "allow": [
    {
      "pattern": "societies-online",
      "route": "/app/filings/prefill",
      "snippet": "does not use BC Societies Online",
      "reason": "Explicit negation: tells a non-society entity that the Societies Online pre-fill does not apply and points it at its own registry."
    },
    {
      "pattern": "society",
      "route": "/app/bylaw-rules",
      "channel": "title",
      "snippet": "articles and by-laws; the society baseline cannot be adopted here",
      "reason": "Explicit negation on the disabled 'adopt baseline' control: says the society baseline is not available for this entity."
    },
    {
      "pattern": "society",
      "route": "*",
      "snippet": "a company, society or other authorized entity may be an incorporator",
      "reason": "Statutory incorporator rule for business corporations (CBCA s.5 / BCA): a society may itself be an incorporator. Correct corporate content."
    },
    {
      "pattern": "bylaws",
      "route": "/app/post-incorporation",
      "workspaces": [
        "cbca-corp"
      ],
      "snippet": "by-laws",
      "reason": "CBCA post-incorporation checklist: federal corporations make, confirm and amend by-laws (CBCA ss.103, 104). Correct for this pathway."
    },
    {
      "pattern": "bylaws",
      "route": "/app/directors",
      "workspaces": [
        "cbca-corp",
        "obca-corp"
      ],
      "snippet": "(CBCA|OBCA) director qualification and by-law requirements",
      "reason": "Pathway-specific director guidance; CBCA and OBCA corporations have by-laws."
    },
    {
      "pattern": "agm",
      "route": "/app/post-incorporation",
      "workspaces": [
        "bc-corp"
      ],
      "snippet": "AGM",
      "reason": "BC Business Corporations Act s.182 uses 'annual general meeting' (and annual reference date) for companies; the BC company checklist is correct."
    },
    {
      "pattern": "members",
      "route": "*",
      "snippet": "workspace member",
      "reason": "Workspace (app user) membership, not members as voters."
    },
    {
      "pattern": "members",
      "route": "/app/post-incorporation",
      "channel": "title",
      "snippet": "BC ordinary/member-funded societies, ordinary private BC companies and federal CBCA",
      "reason": "Tooltip enumerating every supported preparation pathway; naming the society pathway is the point."
    },
    {
      "pattern": "members",
      "route": "*",
      "channel": "title",
      "snippet": "require member/shareholder approval",
      "reason": "Entity-neutral profile hint naming both members and shareholders."
    }
  ],
