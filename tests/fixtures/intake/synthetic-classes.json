        { "p": "Bylaws of Lakeside Clean Air Society" },
        { "p": "Adopted by special resolution on November 21, 2023" },
        { "p": "Part 1 – Interpretation" },
        { "p": "1.1 In these Bylaws, \"Act\" means the Societies Act." },
        { "p": "1.2 The fiscal year of the Society ends on March 31 of each year." },
        { "p": "Part 2 – General Meetings" },
        { "p": "2.1 An annual general meeting must be held at least once in every calendar year." },
        { "p": "2.2 Notice of a general meeting must be sent to every member not less than 14 days and not more than 60 days before the meeting." },
        { "p": "2.3 The quorum for the transaction of business at a general meeting is 10 voting members." },
        { "p": "2.4 Voting by proxy is not permitted." },
        { "p": "2.5 A special resolution requires a 2/3 majority of the votes cast." },
        { "p": "2.6 General meetings may be held by electronic means." },
        { "p": "Part 3 – Directors" },
        { "p": "3.1 The number of directors must be no fewer than 5 and no more than 11." },
        { "p": "3.2 Directors are elected for a term of two years." },
        { "p": "3.3 A majority of the directors in office constitutes a quorum at a meeting of the directors." },
        { "p": "Part 4 – Execution of Documents" },
        { "p": "4.1 Cheques and contracts over $5,000 must be signed by two directors." }
      ],
