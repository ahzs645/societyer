# Public build configuration for the DDC North site on the shared deployment.
# Backend secrets and policy live on Convex, never in VITE_* variables.
VITE_AUTH_MODE=convex
VITE_APP_ONLY=1
VITE_RUNTIME_MODE=convex-cloud
VITE_CONVEX_URL=https://industrious-cricket-610.convex.cloud
VITE_CONVEX_SITE_URL=https://industrious-cricket-610.convex.site
# The backend's DDC workspace policy selects SharePoint and disables native uploads.
VITE_WORKSPACE_SYMBOL_BRAND_ID=ddcnorth
VITE_WORKSPACE_SYMBOL_SIGN_IN_ORIGIN=https://portal.ddcnorth.com
VITE_WORKSPACE_SYMBOL_LIGHT=/ddcnorth/symbol-midnight.svg
VITE_WORKSPACE_SYMBOL_DARK=/ddcnorth/symbol-white.svg
VITE_MEETING_SOURCE_BROKER_URL=https://societyer-ddcnorth-meeting-transfer.ahzs645.workers.dev
