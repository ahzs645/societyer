{
  "name": "societyer-offline-convex-evaluation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "../../node_modules/.bin/vite --host 127.0.0.1 --port 4192 --strictPort",
    "preview": "../../node_modules/.bin/vite preview --host 127.0.0.1 --port 4193 --strictPort",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "lint": "../../node_modules/.bin/eslint src server convex local domain.ts fixture.ts vite.config.ts check-convex.ts check-meetings.ts check-role-invalidation.ts check-live-broker.ts playwright*.config.ts tests live-tests pwa-tests public/service-worker.js",
    "build": "npm run typecheck && ../../node_modules/.bin/vite build",
    "test": "npm run test:convex && npm run test:browser",
    "test:convex": "../../node_modules/.bin/tsx check-convex.ts && ../../node_modules/.bin/tsx check-meetings.ts && ../../node_modules/.bin/tsx check-role-invalidation.ts && ../../node_modules/.bin/tsx check-live-broker.ts",
    "test:browser": "../../node_modules/.bin/playwright test -c playwright.config.ts",
    "test:pwa": "npm run build && ../../node_modules/.bin/playwright test -c playwright.pwa.config.ts",
    "local:start": "node local/start.mjs",
    "local:jwks": "node local/jwks.mjs",
    "local:deploy": "npm run typecheck && node local/deploy.mjs",
    "test:live": "node local/check-live.mjs",
    "local:stop": "docker compose --env-file .env.local -f local/docker-compose.yaml --profile powersync stop",
    "test:powersync:browser": "npm run build && ../../node_modules/.bin/playwright test -c playwright.live.config.ts",
    "dev:live": "SOCIETYER_LOCAL_LIVE_PILOT=1 ../../node_modules/.bin/vite --host 127.0.0.1 --port 4194 --strictPort",
    "local:powersync": "node local/start.mjs --powersync",
    "test:replication": "node local/check-replication.mjs",
    "preview:live": "SOCIETYER_LOCAL_LIVE_PILOT=1 ../../node_modules/.bin/vite preview --host 127.0.0.1 --port 4195 --strictPort",
    "test:connector:race": "node local/check-connector-race.mjs"
  },
  "dependencies": {
    "@powersync/web": "2.4.2",
    "convex": "1.42.1"
  },
  "devDependencies": {
    "jose": "6.2.12",
    "vite-plugin-pwa": "2.0.0"
  }
}
