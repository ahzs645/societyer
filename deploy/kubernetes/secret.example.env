CONVEX_INSTANCE_SECRET=replace-with-convex-instance-secret
BETTER_AUTH_SECRET=replace-with-random-32-byte-secret
SECRET_VAULT_ENCRYPTION_KEY=replace-with-existing-vault-key-or-random-production-key
SOCIETYER_MAINTENANCE_TOKEN=replace-with-random-maintenance-token
CONNECTOR_RUNNER_SECRET=replace-with-random-connector-runner-secret
# Optional Clerk login (also build frontend with its publishable key):
# CLERK_SECRET_KEY=sk_live_REPLACE
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.example
# CLERK_AUTHORIZED_PARTIES=https://your-application.example
# Optional Microsoft SSO when AUTH_MODE=better-auth:
# MICROSOFT_CLIENT_ID=replace-with-entra-application-uuid
# MICROSOFT_CLIENT_SECRET=replace-with-entra-client-secret-value
# MICROSOFT_TENANT_ID=replace-with-entra-directory-uuid

# Optional R2 storage. Also set in Convex function deployment env; see docs/storage-setup.md.
# Existing RustFS deployments keep their current provider configuration.
# SOCIETYER_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
