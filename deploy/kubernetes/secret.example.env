CONVEX_INSTANCE_SECRET=replace-with-convex-instance-secret
BETTER_AUTH_SECRET=replace-with-random-32-byte-secret
SECRET_VAULT_ENCRYPTION_KEY=replace-with-existing-vault-key-or-random-production-key
SOCIETYER_MAINTENANCE_TOKEN=replace-with-random-maintenance-token
CONNECTOR_RUNNER_SECRET=replace-with-random-connector-runner-secret
